<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaGerencia.Pages.FinanzasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaGerencia.Models">

    <ScrollViewer Padding="28,20,28,28" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Finanzas" />
                <TextBlock
                    Opacity="0.8"
                    Text="Septiembre cerrado y octubre en curso. Planilla y honorarios salen del personal de ejemplo."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.75" Text="Ingresos · septiembre" />
                        <TextBlock x:Name="IngresosCerrado" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.75" Text="Egresos · septiembre" />
                        <TextBlock x:Name="EgresosCerrado" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.75" Text="Resultado · septiembre" />
                        <TextBlock x:Name="ResultadoCerrado" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="En planilla" />
                        <TextBlock x:Name="TotalPlanilla" FontWeight="SemiBold" />
                        <ItemsControl x:Name="ListaPlanilla">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:Colaborador">
                                    <Grid Margin="0,0,0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind NombreCompleto}" />
                                            <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind Contrato.CodigoPago}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Contrato.SueldoTexto}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recibo por honorarios" />
                        <TextBlock x:Name="TotalHonorarios" FontWeight="SemiBold" />
                        <ItemsControl x:Name="ListaHonorarios">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:Colaborador">
                                    <Grid Margin="0,0,0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind NombreCompleto}" />
                                            <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind Contrato.CodigoPago}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Contrato.SueldoTexto}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="NotaRetirados" Opacity="0.75" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Movimientos de septiembre" />
            <ItemsControl x:Name="ListaCerrado">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:Movimiento">
                        <Border Margin="0,0,0,8" Style="{StaticResource TarjetaEstilo}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="{x:Bind Fecha}" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Concepto}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.7" Text="{x:Bind Categoria}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind MontoTexto}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Octubre en curso, al 5 de octubre" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="La planilla y los honorarios de octubre todavía no se cierran. Arriba está el compromiso estimado del personal activo."
                Severity="Informational"
                Title="Mes abierto" />
            <ItemsControl x:Name="ListaCurso">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:Movimiento">
                        <Border Margin="0,0,0,8" Style="{StaticResource TarjetaEstilo}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="{x:Bind Fecha}" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Concepto}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.7" Text="{x:Bind Categoria}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind MontoTexto}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
