<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaGerencia.Pages.AgendaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaGerencia.Models">

    <Grid Padding="28,20,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Agenda" />
                <TextBlock Opacity="0.8" Text="Abre una reunión para cambiar la fecha, la hora y las personas." />
            </StackPanel>
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="NuevaCita_Click"
                Content="Nueva reunión" />
        </Grid>

        <InfoBar
            x:Name="AvisoCita"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Success"
            Title="Reunión agregada" />

        <Border Grid.Row="2" Style="{StaticResource TarjetaEstilo}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="OcupacionTexto" />
                <ProgressBar x:Name="OcupacionBarra" Maximum="8" />
            </StackPanel>
        </Border>

        <ListView
            x:Name="CitasLista"
            Grid.Row="3"
            IsItemClickEnabled="True"
            ItemClick="CitasLista_ItemClick"
            Padding="2,2,8,8"
            ItemContainerStyle="{StaticResource FilaListaEstilo}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:CitaDia">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Hora}" />
                            <TextBlock FontSize="12" Opacity="0.75" Text="{x:Bind FechaTexto}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Asunto}" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.75" Text="{x:Bind PersonasTexto}" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Opacity="0.6" Text="{x:Bind ConteoTexto}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind Sala}" />
                            <Border
                                Padding="8,2"
                                HorizontalAlignment="Right"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <TextBlock FontSize="12" Text="{x:Bind Estado}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
