<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaGerencia.Pages.InventarioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaGerencia.Models">

    <ScrollViewer Padding="28,20,28,28">
        <StackPanel MaxWidth="860" HorizontalAlignment="Center" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Inventario" />
                <TextBlock Opacity="0.8" Text="Insumos de ejemplo para cirugía y cabina. El stock bajo también aparece en Alertas." />
            </StackPanel>

            <ItemsControl x:Name="Lista">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:Insumo">
                        <Border Margin="0,0,0,10" Style="{StaticResource TarjetaEstilo}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" />
                                    <Border
                                        Padding="8,2"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock FontSize="12" Text="{x:Bind NivelTexto}" />
                                    </Border>
                                </Grid>
                                <TextBlock Opacity="0.75" Text="{x:Bind StockTexto}" />
                                <ProgressBar Maximum="{x:Bind Capacidad}" Value="{x:Bind Stock}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
