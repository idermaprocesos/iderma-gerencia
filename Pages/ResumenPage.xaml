<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaGerencia.Pages.ResumenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaGerencia.Models"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="28,20,28,28" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Resumen y control" />
                <TextBlock
                    Opacity="0.8"
                    Text="Corte de ejemplo · lunes 5 de octubre de 2026. Los números son temporales." />
            </StackPanel>

            <InfoBar
                IsClosable="True"
                IsOpen="True"
                Message="Los contratos de trabajadores y doctores se gestionan en Administración. Aquí puedes agregar y editar reuniones. Los cambios se conservan mientras la aplicación sigue abierta."
                Severity="Informational"
                Title="Datos de ejemplo" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.75" Text="Trabajadores activos" />
                        <TextBlock x:Name="KpiTrabajadores" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="KpiTrabajadoresDetalle" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Opacity="0.65" Text="Contratos en Administración" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.75" Text="Doctores activos" />
                        <TextBlock x:Name="KpiDoctores" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="KpiDoctoresDetalle" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Opacity="0.65" Text="Contratos en Administración" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Click="IrFinanzas_Click" Style="{StaticResource TarjetaBotonEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.75" Text="Planilla del mes" />
                        <TextBlock x:Name="KpiPlanilla" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Opacity="0.7" Text="Personal activo en nómina" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Opacity="0.65" Text="Abrir finanzas" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Click="IrFinanzas_Click" Style="{StaticResource TarjetaBotonEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.75" Text="Honorarios del mes" />
                        <TextBlock x:Name="KpiHonorarios" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Opacity="0.7" Text="Recibos por honorarios" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Opacity="0.65" Text="Abrir finanzas" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" MinWidth="0" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="16">
                    <Border Style="{StaticResource TarjetaEstilo}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Agenda de hoy" TextWrapping="Wrap" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="IrAgenda_Click"
                                    Content="Ver agenda" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="OcupacionTexto" Opacity="0.8" />
                                <ProgressBar x:Name="OcupacionBarra" Maximum="8" />
                            </StackPanel>
                            <ItemsControl x:Name="CitasLista">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:CitaDia">
                                        <Grid Margin="0,0,0,10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Hora}" />
                                                <TextBlock Opacity="0.7" FontSize="12" Text="{x:Bind FechaTexto}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Asunto}" />
                                                <TextBlock Opacity="0.7" Text="{x:Bind PersonasTexto}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Opacity="0.75" Text="{x:Bind Estado}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TarjetaEstilo}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Actividad reciente" />
                            <ItemsControl x:Name="ActividadLista">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:Actividad">
                                        <Grid Margin="0,0,0,10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Opacity="0.7" Text="{x:Bind Momento}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Texto}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource TarjetaEstilo}" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Panel de control" />
                        <TextBlock Opacity="0.75" Text="Estos interruptores valen solo en esta sesión." TextWrapping="Wrap" />

                        <ToggleSwitch
                            x:Name="ExigirImagen"
                            Header="Exigir autorización de imagen"
                            OffContent="No se exige"
                            OnContent="Activo para campañas" />
                        <ToggleSwitch
                            x:Name="AvisarVencimientos"
                            Header="Avisar vencimientos"
                            OffContent="Avisos apagados"
                            OnContent="Contratos y consentimientos a 45 días" />

                        <TextBlock x:Name="EstadoControles" Opacity="0.85" TextWrapping="Wrap" />

                        <InfoBar
                            x:Name="AvisoAccion"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Informational" />

                        <StackPanel Spacing="8">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="IrFinanzas_Click" Content="Ver planilla y honorarios" />
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Cierre_Click" Content="Simular cierre" />
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Text="Pendientes" />
                        <ListView
                            x:Name="PendientesLista"
                            MaxHeight="240"
                            IsItemClickEnabled="True"
                            ItemClick="PendientesLista_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Alerta">
                                    <StackPanel Padding="0,6" Spacing="2">
                                        <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind Severidad}" />
                                        <TextBlock Text="{x:Bind Titulo}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <HyperlinkButton x:Name="VerAlertas" Click="IrAlertas_Click" Content="Ver alertas" />
                        <HyperlinkButton Click="IrMarketing_Click" Content="Revisar autorizaciones de imagen" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SedeCard1" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SedeNombre1" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedeEnfoque1" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedeHorario1" Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedePersonal1" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedeEstado1" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border x:Name="SedeCard2" Grid.Column="1" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SedeNombre2" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedeEnfoque2" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedeHorario2" Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedePersonal2" TextWrapping="Wrap" />
                        <TextBlock x:Name="SedeEstado2" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
