<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaGerencia.Pages.MarketingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaGerencia.Models">

    <Grid Padding="28,20,28,12" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Marketing e imagen" />
                <TextBlock
                    x:Name="ResumenImagen"
                    Opacity="0.8"
                    TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar x:Name="AvisoExigencia" IsClosable="False" IsOpen="True" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            MaxHeight="280"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Campañas de ejemplo" />
                <ItemsControl x:Name="CampanasLista">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:Campana">
                            <Border Margin="0,0,0,10" Style="{StaticResource TarjetaEstilo}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.75" Text="{x:Bind Estado}" />
                                    </Grid>
                                    <TextBlock Opacity="0.75" Text="{x:Bind Canal}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind NotaConsentimiento}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Autorización de cada persona" />
                <TextBlock Opacity="0.75" Text="Abre una fila para ver el contrato completo." TextWrapping="Wrap" />
            </StackPanel>
            <ListView
                x:Name="PersonasLista"
                Grid.Row="1"
                Padding="2,2,8,8"
                IsItemClickEnabled="True"
                ItemClick="PersonasLista_ItemClick"
                ItemContainerStyle="{StaticResource FilaListaEstilo}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Colaborador">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind NombreCompleto}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.75" Text="{x:Bind RolTexto}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Contrato.AceptaImagenCorto}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Opacity="0.8"
                                Text="{x:Bind Contrato.CanalesTexto}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
