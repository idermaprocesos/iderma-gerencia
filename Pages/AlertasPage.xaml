<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaGerencia.Pages.AlertasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaGerencia.Models">

    <Grid Padding="28,20,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Alertas" />
            <TextBlock
                x:Name="Subtitulo"
                Opacity="0.8"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            x:Name="Lista"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="Lista_ItemClick"
            Padding="2,2,8,8"
            ItemContainerStyle="{StaticResource FilaListaEstilo}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Alerta">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Severidad}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Titulo}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.8" Text="{x:Bind Detalle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind DestinoTexto}" />
                        </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
