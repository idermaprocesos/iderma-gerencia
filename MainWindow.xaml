<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="IdermaGerencia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Iderma Capilar — Gerencia">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColumnaIzquierda" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColumnaDerecha" Width="138" />
            </Grid.ColumnDefinitions>
            <TitleBar
                x:Name="AppTitleBar"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Title="Iderma Capilar"
                Subtitle="Gerencia · datos de ejemplo"
                BackRequested="TitleBar_BackRequested"
                IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="TitleBar_PaneToggleRequested">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="280"
            PaneDisplayMode="Left"
            ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Resumen y control" IsSelected="True" Tag="resumen">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Operación" />
                <NavigationViewItem Content="Agenda" Tag="agenda">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Finanzas" Tag="finanzas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE825;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Inventario" Tag="inventario">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Clínica" />
                <NavigationViewItem Content="Marketing e imagen" Tag="marketing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE789;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Alertas" Tag="alertas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock
                    Margin="16,8,16,16"
                    FontSize="12"
                    Opacity="0.7"
                    Text="Iderma Capilar"
                    TextWrapping="Wrap" />
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
