<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaGerencia.Dialogos.EditorCitaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaGerencia.Models"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Guardar_Click"
    PrimaryButtonText="Guardar">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock x:Name="ErrorTexto" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker
                x:Name="Fecha"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                Header="Fecha" />
            <TimePicker
                x:Name="Hora"
                Grid.Column="1"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                ClockIdentifier="24HourClock"
                Header="Hora"
                MinuteIncrement="1" />
        </Grid>
        <TextBox x:Name="Asunto" MinWidth="0" Header="Asunto de la reunión" PlaceholderText="Comité de gerencia" />
        <ComboBox x:Name="Sala" MinWidth="0" HorizontalAlignment="Stretch" Header="Lugar" IsEditable="True" />
        <ComboBox x:Name="Estado" MinWidth="0" HorizontalAlignment="Stretch" Header="Estado" />

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Personas" />
            <TextBlock Opacity="0.75" Text="Agrega a una o varias personas del personal, o escribe un nombre." TextWrapping="Wrap" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="Persona"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    IsEditable="True"
                    PlaceholderText="Nombre" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="AgregarPersona_Click" Content="Agregar" />
            </Grid>
            <TextBlock x:Name="SinPersonas" Opacity="0.7" Text="Todavía no hay personas en esta reunión." />
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PersonasLista">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:AsistenteReunion">
                            <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Nombre}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Click="QuitarPersona_Click" Content="Quitar" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </StackPanel>
</ContentDialog>
