<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaGerencia.Dialogos.EditorPersonaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Guardar_Click"
    PrimaryButtonText="Guardar">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="520"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <TextBlock x:Name="ErrorTexto" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Identidad" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="Nombres" MinWidth="0" Header="Nombres" />
                <TextBox x:Name="Apellidos" Grid.Column="1" MinWidth="0" Header="Apellidos" />
                <TextBox x:Name="Documento" Grid.Row="1" MinWidth="0" Header="Documento" />
                <TextBox x:Name="Telefono" Grid.Row="1" Grid.Column="1" MinWidth="0" Header="Teléfono" />
                <TextBox x:Name="Correo" Grid.Row="2" Grid.ColumnSpan="2" MinWidth="0" Header="Correo" />
            </Grid>

            <StackPanel x:Name="BloqueMedico" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Datos médicos" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Colegiatura" MinWidth="0" Header="Colegiatura" />
                    <TextBox x:Name="Especialidad" Grid.Column="1" MinWidth="0" Header="Especialidad" />
                </Grid>
            </StackPanel>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Contrato" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="NumeroContrato" MinWidth="0" Header="Número de contrato" />
                <ComboBox x:Name="TipoContrato" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" Header="Tipo de contrato" />
                <TextBox x:Name="Cargo" Grid.Row="1" MinWidth="0" Header="Cargo" />
                <TextBox x:Name="Area" Grid.Row="1" Grid.Column="1" MinWidth="0" Header="Área" />
                <ComboBox x:Name="Sede" Grid.Row="2" MinWidth="0" HorizontalAlignment="Stretch" Header="Sede" />
                <ComboBox x:Name="Jornada" Grid.Row="2" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" Header="Jornada" />
                <TextBox x:Name="Horario" Grid.Row="3" Grid.ColumnSpan="2" MinWidth="0" Header="Horario" />
                <CalendarDatePicker x:Name="FechaIngreso" Grid.Row="4" MinWidth="0" Header="Fecha de ingreso" HorizontalAlignment="Stretch" />
                <CalendarDatePicker x:Name="FechaFin" Grid.Row="4" Grid.Column="1" MinWidth="0" Header="Fin de contrato, si tiene" HorizontalAlignment="Stretch" />
            </Grid>

            <CheckBox x:Name="SeRetiro" Checked="Retiro_Changed" Content="Se retiró" Unchecked="Retiro_Changed" />
            <Grid x:Name="BloqueRetiro" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CalendarDatePicker x:Name="FechaRetiro" MinWidth="0" Header="Fecha de retiro" HorizontalAlignment="Stretch" />
                <TextBox x:Name="MotivoRetiro" Grid.Column="1" MinWidth="0" Header="Motivo de retiro" />
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Pago" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <NumberBox x:Name="Sueldo" MinWidth="0" HorizontalAlignment="Stretch" Header="Sueldo mensual (S/)" Minimum="0" SpinButtonPlacementMode="Compact" />
                <ComboBox x:Name="Modalidad" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" Header="Modalidad" />
                <TextBox x:Name="CodigoPago" Grid.Row="1" MinWidth="0" Header="Código de planilla o de recibo" />
                <TextBox x:Name="Banco" Grid.Row="1" Grid.Column="1" MinWidth="0" Header="Banco" />
                <TextBox x:Name="Cuenta" Grid.Row="2" Grid.ColumnSpan="2" MinWidth="0" Header="Cuenta" />
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Uso de imagen" />
            <ToggleSwitch x:Name="AceptaImagen" Header="Acepta el uso de su imagen para marketing" OffContent="No acepta" OnContent="Sí acepta" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="Canales" MinWidth="0" Header="Canales autorizados" TextWrapping="Wrap" />
                <TextBox x:Name="Restricciones" Grid.Column="1" MinWidth="0" Header="Restricciones" TextWrapping="Wrap" />
                <CalendarDatePicker x:Name="FechaConsentimiento" Grid.Row="1" MinWidth="0" Header="Fecha de aceptación" HorizontalAlignment="Stretch" />
                <CalendarDatePicker x:Name="VencimientoImagen" Grid.Row="1" Grid.Column="1" MinWidth="0" Header="Vencimiento de la autorización" HorizontalAlignment="Stretch" />
            </Grid>

            <TextBox x:Name="Observaciones" Header="Observaciones internas" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
